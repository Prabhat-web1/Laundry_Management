# PostgreSQL (Neon, Vercel Postgres, Supabase, Railway, local Postgres, ...)
# DATABASE_URL: pooled connection string used by the running app.
# DIRECT_URL:   direct (non-pooled) connection string used by Prisma Migrate.
# If your provider has no separate pooled URL (e.g. local Postgres), use the same value for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/washday?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/washday?sslmode=require"
