generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection string used by the running app (Vercel / serverless).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection string used by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

enum LaundryStatus {
  REQUESTED
  COLLECTED
  WASHING
  DRYING
  READY
  DELIVERED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum UserRole {
  STUDENT
  STAFF
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(STUDENT)
  studentId    String?   @unique
  room         String    @default("")
  hostel       String    @default("")
  phone        String    @default("")
  sessions     Session[]
  requests     LaundryRequest[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LaundryRequest {
  id           String        @id @default(cuid())
  studentName  String
  studentId    String
  userId       String
  room         String
  hostel       String
  phone        String
  items        String
  pickupAt     DateTime
  dropOffAt    DateTime
  expectedAt   DateTime
  notes        String        @default("")
  status       LaundryStatus @default(REQUESTED)
  batchTag     String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  disputes     Dispute[]
  user         User          @relation(fields: [userId], references: [id])

  @@index([studentId, createdAt])
  @@index([status, expectedAt])
}

model Dispute {
  id          String       @id @default(cuid())
  requestId   String
  itemName    String
  issueType   String
  description String
  status      DisputeStatus @default(OPEN)
  resolution  String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  request     LaundryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
